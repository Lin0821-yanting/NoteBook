# ---------------------------------------------------------------
# 個人資料：不上傳到 GitHub
# 第一次執行 main.py 時會自動重新建立，clone 下來的人會得到全新的空資料庫
# （注意：.gitignore 的註解必須獨立一行，不能寫在規則後面）
# ---------------------------------------------------------------

# SQLite 資料庫（帳號、筆記、資料夾）與 secret_key
instance/
# 使用者上傳的圖片、手寫圖
uploads/
*.db
*.sqlite
*.sqlite3
*.db-journal
# 從系統下載的筆記備份檔
notebook-backup-*.json
.env
.env.*

# ---------------------------------------------------------------
# 執行環境：每個人自己建立（見 README「環境建立」）
# ---------------------------------------------------------------
.venv/
venv/
env/
.conda/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------------------------------------------------------------
# 編輯器 / 作業系統 / 本機工具
# ---------------------------------------------------------------
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
desktop.ini
*.log
